---
import { NoodlestanFooter, MadeInNoodlestan } from '@noodlestan/astro-components';
import { ENDPOINTS } from '../../constants';

const year = new Date().getFullYear();
---

<footer>
	<div>
		<MadeInNoodlestan />
	</div>
	<NoodlestanFooter year={year} githubURL={ENDPOINTS['art-md'].github} />
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-block: 7rem 3rem;
		background: linear-gradient(180deg, var(--color-gradient-3) 60%, var(--color-gradient-2) 95%);

		> :global(div) {
			margin: 0 var(--page-margin-h);
		}
	}

	div {
		font-size: 1.5rem;
	}
</style>
