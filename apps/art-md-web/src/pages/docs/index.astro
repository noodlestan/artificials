---
import PageLayout from '../../layouts/PageLayout.astro';

const content = {
	title: 'Docs',
	description: 'Art MD documentation.',
};

const countModules = (moduleNames: string[]) =>
	moduleNames.length === 1 ? '1 module' : `${moduleNames.length} modules`;

const countEntities = (entityCount: number) =>
	entityCount === 1 ? '1 entity' : `${entityCount} entities`;
---

<PageLayout content={content}>
	<h1>Docs</h1>
	<p>
		Documentation for <code>@art-md</code>.
	</p>
	<h2>Index</h2>
	<ul>
		<li>
			<a href="/docs/api">API documentation</a> — extracted from the <code>@art-md</code> packages.
		</li>
	</ul>
</PageLayout>
