---
import JsDocBlock from '@purrtrait/astro-components/components/JsDocBlock.astro';

import type { DocsResolveLink } from '../../lib/meta';

interface Props {
	jsdoc: { description?: string; tags?: Record<string, string | string[]> };
	resolveLink?: DocsResolveLink;
}

const { jsdoc, resolveLink } = Astro.props;

const hasTags = Boolean(jsdoc.tags && Object.keys(jsdoc.tags).length > 0);
const show = Boolean(jsdoc.description) || hasTags;
---

{show && (
	<section>
		<h2>Summary</h2>
		<JsDocBlock jsdoc={jsdoc} resolveLink={resolveLink} />
	</section>
)}
