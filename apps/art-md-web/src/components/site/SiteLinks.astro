---
import { GithubIconLink, DiscordIconLink } from '@noodlestan/astro-components';
import { ENDPOINTS } from '../../constants';
---

<div class="site-links">
	<GithubIconLink href={ENDPOINTS.noodlestan.github} />
	<DiscordIconLink href={ENDPOINTS.noodlestan.discord} />
</div>

<style>
	.container {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		row-gap: 1rem;
		column-gap: 2rem;
		padding-block: 1.5rem;
	}

	.site-title {
		text-decoration: none;
	}

	.site-nav {
		display: none;
	}

	.site-links {
		display: inline-flex;
		justify-content: end;
		gap: 1rem;
		margin-bottom: -0.25rem;
		font-size: calc(var(--text-size-nav) * 0.85);
		line-height: 1;
	}

	@media screen and (min-width: 1022px) {
		.site-links {
			width: 13rem;
		}
		.site-nav {
			display: flex;
		}
	}
</style>
