---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { FunctionDeclaration, TypeDeclaration } from '@purrception/lang-ts';
import {
	getEntityFunctions,
	getEntityTypes,
	type PurrfilesEntityData,
} from '@noodlestan/purrfiles-entities';

import DocsBreadcrumbs from '../../../../../../../components/docs/DocsBreadcrumbs.astro';
import EntitySummary from '../../../../../../../components/docs/EntitySummary.astro';
import FunctionsSection from '../../../../../../../components/docs/FunctionsSection.astro';
import TypesSection from '../../../../../../../components/docs/TypesSection.astro';
import PageLayout from '../../../../../../../layouts/PageLayout.astro';
import { createDocsResolveLink } from '../../../../../../../lib/meta';
import { packageParts } from '../../../../../../../lib/routes';

interface Props {
	entry: CollectionEntry<'entities'>;
	functions: FunctionDeclaration[];
	types: TypeDeclaration[];
}

export async function getStaticPaths() {
	const all = await getCollection('entities');

	return all.map(entry => {
		const { package: pkg, type, name, module } = entry.data;

		// A module entity is its own module; other entity types name theirs explicitly.
		const mod = module ?? name;
		const { namespace, name: pkgName } = packageParts(pkg);

		// Canonical helpers filter on `kind`, so a module entity yields its
		// functions and types — never functions twice. Cast bridges the
		// zod-validated entry data onto the entity shape they expect.
		const entity = entry.data as unknown as PurrfilesEntityData;
		const functions = getEntityFunctions(entity, entity.functions) as FunctionDeclaration[];
		const types = getEntityTypes(entity) as TypeDeclaration[];

		return {
			params: { ns: namespace, pkg: pkgName, mod, type, ent: name },
			props: { entry, functions, types },
		};
	});
}

const { entry, functions, types } = Astro.props;
const { package: pkg, type, name, description } = entry.data;

// The `entities` schema is a loose object, so `tags` is carried but untyped.
const tags = (entry.data as { tags?: Record<string, string | string[]> }).tags ?? {};
const all = await getCollection('entities');
const resolveLink = createDocsResolveLink(
	all.map(candidate => candidate.data as unknown as PurrfilesEntityData),
);

// v1 only renders the `module` type; any other type is an unknown page.
const known = type === 'module';

const content = {
	title: `${type}: ${name}`,
	description: description ?? `${type} ${name}.`,
};
---

<PageLayout content={content}>
	{!known ? (
		<>
			<h1>Page not found</h1>
			<p>
				Entity {pkg}/{type}:{name} is not available yet.
			</p>
			<p>
				<a href="/docs">Docs home</a>
			</p>
		</>
	) : (
		<>
			<DocsBreadcrumbs pkg={pkg} mod={name} type={type} ent={name} />
			<h1>{name}</h1>
			<EntitySummary jsdoc={{ description, tags }} resolveLink={resolveLink} />
			<FunctionsSection functions={functions} resolveLink={resolveLink} />
			<TypesSection types={types} resolveLink={resolveLink} />
		</>
	)}
</PageLayout>
