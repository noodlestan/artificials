---
import type { FunctionDeclaration, FunctionJsDocData } from '@purrception/lang-ts';
import CodeBlock from '@purrtrait/astro-components/components/CodeBlock.astro';
import JsDocBlock from '@purrtrait/astro-components/components/JsDocBlock.astro';

import type { DocsResolveLink } from '../../lib/meta';

interface Props {
	functions: FunctionDeclaration[];
	resolveLink?: DocsResolveLink;
}

const { functions, resolveLink } = Astro.props;
---

{functions.length > 0 && (
	<section>
		<h2>Functions</h2>
		{functions.map(fn => (
			<section>
				<h3 id={fn.name}>{fn.name}</h3>
				<CodeBlock lang="ts" nodes={[fn]} />
				<JsDocBlock jsdoc={fn.node as FunctionJsDocData} resolveLink={resolveLink} />
			</section>
		))}
	</section>
)}
