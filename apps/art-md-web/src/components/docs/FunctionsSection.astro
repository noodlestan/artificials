---
import type { FunctionDeclaration } from '@purrception/lang-ts';
import CodeBlock from '@purrtrait/astro-components/components/CodeBlock.astro';

interface Props {
	functions: FunctionDeclaration[];
}

const { functions } = Astro.props;
---

{functions.length > 0 && (
	<section>
		<h2>Functions</h2>
		{functions.map(fn => (
			<section>
				<h3>{fn.name}</h3>
				<CodeBlock lang="ts" nodes={[fn]} />
			</section>
		))}
	</section>
)}
