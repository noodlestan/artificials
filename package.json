{
  "name": "noodlestan/artificials",
  "version": "0.0.1",
  "description": "A collection of tools and resources to generate and manage knowledge artefacts and agent instructions.",
  "keywords": [
    "art",
    "markdown",
    "agent-workflows",
    "delegation",
    "agent-instructions"
  ],
  "author": "Noodlestan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/artificials.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/**"
  ],
  "prettier": "@noodlestan/prettier-config",
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -c --write",
    "extract": "echo no purrception yet",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "devDependencies": {
    "@noodlestan/conventions-typescript": "0.1.0",
    "@noodlestan/conventions-unit-tests": "0.1.0",
    "@noodlestan/prettier-config": "0.1.1",
    "@noodlestan/tsconfig": "0.2.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
